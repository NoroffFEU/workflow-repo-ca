{
  "root": true,
  "env": {
    "es2022": true,
    "browser": true,
    "node": true
  },
  "extends": [
    "eslint:recommended",
    "plugin:vitest/recommended",
    "plugin:playwright/recommended",
    "eslint-config-prettier"
  ],
  "overrides": [
    {
      "files": ["tests/**/*.{test,spec}.js"],
      "env": { "vitest-globals": true }
    },
    {
      "files": ["tests-e2e/**/*.{js,ts}"],
      "env": { "node": true }
    }
  ],
  "parserOptions": {
    "ecmaVersion": "latest",
    "sourceType": "module"
  },
  "rules": {
    "no-unused-vars": ["warn", { "argsIgnorePattern": "^_" }]
  }
}
