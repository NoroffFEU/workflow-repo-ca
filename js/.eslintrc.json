{
  "env": {
    "browser": true,
    "es2021": true,
    "node": true,
    "vitest-globals/env": true,
    "playwright/playwright-test": true
  },
  "extends": [
    "eslint:recommended",
    "plugin:vitest-globals/recommended",
    "plugin:playwright/recommended",
    "prettier"
  ],
  "plugins": ["vitest-globals", "playwright"],
  "rules": {
    "no-unused-vars": "warn",
    "no-undef": "error"
  }
}
