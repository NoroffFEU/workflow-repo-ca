{
  "name": "workflow-repo-ca",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "http-server -p 5173 .",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:ui": "vitest",
    "test:e2e": "playwright test",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{html,css,md,json}": [
      "prettier --write"
    ]
  },
  "devDependencies": {
    "@playwright/test": "^1.48.2",
    "@vitest/coverage-v8": "^2.1.3",
    "eslint": "^9.11.1",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-vitest": "^0.5.3",
    "http-server": "^14.1.1",
    "husky": "^9.1.6",
    "jsdom": "^24.1.0",
    "lint-staged": "^15.2.9",
    "prettier": "^3.3.3",
    "vitest": "^2.1.3"
  }
}
