{
  "name": "workflow-repo",
  "version": "1.0.0",
  "private": true,
  "description": "",
  "main": "index.js",
  "scripts": {
    "dev": "npx tailwindcss -i ./css/input.css -o ./css/style.css --watch",
    "lint": "eslint .",
    "format": "prettier . -w",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "prepare": "husky",
    "e2e": "playwright test",
    "e2e:headed": "playwright test --headed",
    "serve": "http-server -p 5173 -c-1 ."
  },
  "lint-staged": {
    "*.html": "prettier -w",
    "*.{js,jsx,cjs,mjs,ts,tsx}": [
      "prettier -w",
      "eslint --fix"
    ]
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@playwright/test": "^1.56.1",
    "@vitest/coverage-v8": "^3.2.4",
    "eslint": "^9.38.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.32.0",
    "http-server": "^14.1.1",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.4",
    "prettier": "^3.6.2",
    "tailwindcss": "^3.4.12",
    "vitest": "^3.2.4"
  }
}
