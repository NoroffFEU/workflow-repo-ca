{
  "name": "workflow-repo",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "start": "live-server --port=5500",
    "dev": "npx tailwindcss -i ./css/input.css -o ./css/style.css --watch",
    "prepare": "husky",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test:unit": "vitest --config vitest.config.js",
    "test:e2e": "npx playwright test --config=playwright.config.cjs",
    "test:e2e:ui": "npx playwright test --ui --config=playwright.config.cjs",
    "test:e2e:debug": "npx playwright test --debug --config=playwright.config.cjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.1",
    "dotenv": "^17.2.3",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.32.0",
    "husky": "^9.1.7",
    "jsdom": "^27.0.0",
    "lint-staged": "^15.2.10",
    "live-server": "^1.2.2",
    "prettier": "^3.6.2",
    "tailwindcss": "^3.4.12"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,css,md}": [
      "prettier --write"
    ],
    "**/*.{html,css,md,json}": [
      "prettier --write"
    ]
  }
}
